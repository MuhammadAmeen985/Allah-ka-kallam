{
  "id": 94,
  "nameArabic": "الشرح",
  "nameTransliteration": "Ash-Sharh",
  "nameEnglish": "The Consolation",
  "ayahCount": 8,
  "revelationType": "Meccan",
  "revelationOrder": 12,
  "rukus": 1,
  "startAyahGlobal": 6090,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
      "translations": {
        "en": {
          "text": "Did We not expand for you, [O Muhammad], your breast?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(اے محمدﷺ) کیا ہم نے تمہارا سینہ کھول نہیں دیا؟ (بےشک کھول دیا)",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
      "translations": {
        "en": {
          "text": "And We removed from you your burden",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور تم پر سے بوجھ بھی اتار دیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
      "translations": {
        "en": {
          "text": "Which had weighed upon your back",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جس نے تمہاری پیٹھ توڑ رکھی تھی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "translations": {
        "en": {
          "text": "And raised high for you your repute.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور تمہارا ذکر بلند کیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "translations": {
        "en": {
          "text": "For indeed, with hardship [will be] ease.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ہاں ہاں مشکل کے ساتھ آسانی بھی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 6,
      "arabic": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "translations": {
        "en": {
          "text": "Indeed, with hardship [will be] ease.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(اور) بے شک مشکل کے ساتھ آسانی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 7,
      "arabic": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
      "translations": {
        "en": {
          "text": "So when you have finished [your duties], then stand up [for worship].",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو جب فارغ ہوا کرو تو (عبادت میں) محنت کیا کرو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 8,
      "arabic": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
      "translations": {
        "en": {
          "text": "And to your Lord direct [your] longing.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور اپنے پروردگار کی طرف متوجہ ہو جایا کرو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
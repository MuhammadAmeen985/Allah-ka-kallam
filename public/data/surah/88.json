{
  "id": 88,
  "nameArabic": "الغاشية",
  "nameTransliteration": "Al-Ghaashiya",
  "nameEnglish": "The Overwhelming",
  "ayahCount": 26,
  "revelationType": "Meccan",
  "revelationOrder": 68,
  "rukus": 1,
  "startAyahGlobal": 5967,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
      "translations": {
        "en": {
          "text": "Has there reached you the report of the Overwhelming [event]?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بھلا تم کو ڈھانپ لینے والی (یعنی قیامت کا) حال معلوم ہوا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ",
      "translations": {
        "en": {
          "text": "[Some] faces, that Day, will be humbled,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اس روز بہت سے منہ (والے) ذلیل ہوں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "عَامِلَةٌ نَّاصِبَةٌ",
      "translations": {
        "en": {
          "text": "Working [hard] and exhausted.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "سخت محنت کرنے والے تھکے ماندے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "تَصْلَىٰ نَارًا حَامِيَةً",
      "translations": {
        "en": {
          "text": "They will [enter to] burn in an intensely hot Fire.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "دہکتی آگ میں داخل ہوں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "translations": {
        "en": {
          "text": "They will be given drink from a boiling spring.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ایک کھولتے ہوئے چشمے کا ان کو پانی پلایا جائے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 6,
      "arabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "translations": {
        "en": {
          "text": "For them there will be no food except from a poisonous, thorny plant",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور خار دار جھاڑ کے سوا ان کے لیے کوئی کھانا نہیں (ہو گا)",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 7,
      "arabic": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "translations": {
        "en": {
          "text": "Which neither nourishes nor avails against hunger.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جو نہ فربہی لائے اور نہ بھوک میں کچھ کام آئے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 8,
      "arabic": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "translations": {
        "en": {
          "text": "[Other] faces, that Day, will show pleasure.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور بہت سے منہ (والے) اس روز شادماں ہوں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 9,
      "arabic": "لِّسَعْيِهَا رَاضِيَةٌ",
      "translations": {
        "en": {
          "text": "With their effort [they are] satisfied",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اپنے اعمال (کی جزا) سے خوش دل",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 10,
      "arabic": "فِى جَنَّةٍ عَالِيَةٍ",
      "translations": {
        "en": {
          "text": "In an elevated garden,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بہشت بریں میں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 11,
      "arabic": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةً",
      "translations": {
        "en": {
          "text": "Wherein they will hear no unsuitable speech.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "وہاں کسی طرح کی بکواس نہیں سنیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 12,
      "arabic": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "translations": {
        "en": {
          "text": "Within it is a flowing spring.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اس میں چشمے بہ رہے ہوں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 13,
      "arabic": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "translations": {
        "en": {
          "text": "Within it are couches raised high",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "وہاں تخت ہوں گے اونچے بچھے ہوئے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 14,
      "arabic": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "translations": {
        "en": {
          "text": "And cups put in place",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور آبخورے (قرینے سے) رکھے ہوئے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 15,
      "arabic": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "translations": {
        "en": {
          "text": "And cushions lined up",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور گاؤ تکیے قطار کی قطار لگے ہوئے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 16,
      "arabic": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "translations": {
        "en": {
          "text": "And carpets spread around.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور نفیس مسندیں بچھی ہوئی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 17,
      "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "translations": {
        "en": {
          "text": "Then do they not look at the camels - how they are created?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "یہ لوگ اونٹوں کی طرف نہیں دیکھتے کہ کیسے (عجیب) پیدا کیے گئے ہیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 18,
      "arabic": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "translations": {
        "en": {
          "text": "And at the sky - how it is raised?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور آسمان کی طرف کہ کیسا بلند کیا گیا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 19,
      "arabic": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "translations": {
        "en": {
          "text": "And at the mountains - how they are erected?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور پہاڑوں کی طرف کہ کس طرح کھڑے کیے گئے ہیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 20,
      "arabic": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "translations": {
        "en": {
          "text": "And at the earth - how it is spread out?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور زمین کی طرف کہ کس طرح بچھائی گئی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 21,
      "arabic": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "translations": {
        "en": {
          "text": "So remind, [O Muhammad]; you are only a reminder.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو تم نصیحت کرتے رہو کہ تم نصیحت کرنے والے ہی ہو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 22,
      "arabic": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "translations": {
        "en": {
          "text": "You are not over them a controller.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تم ان پر داروغہ نہیں ہو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 23,
      "arabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "translations": {
        "en": {
          "text": "However, he who turns away and disbelieves -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ہاں جس نے منہ پھیرا اور نہ مانا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 24,
      "arabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "translations": {
        "en": {
          "text": "Then Allah will punish him with the greatest punishment.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو خدا اس کو بڑا عذاب دے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 25,
      "arabic": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "translations": {
        "en": {
          "text": "Indeed, to Us is their return.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بےشک ان کو ہمارے پاس لوٹ کر آنا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 26,
      "arabic": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "translations": {
        "en": {
          "text": "Then indeed, upon Us is their account.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر ہم ہی کو ان سے حساب لینا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
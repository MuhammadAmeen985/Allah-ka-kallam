{
  "id": 53,
  "nameArabic": "النجم",
  "nameTransliteration": "An-Najm",
  "nameEnglish": "The Star",
  "ayahCount": 62,
  "revelationType": "Meccan",
  "revelationOrder": 23,
  "rukus": 3,
  "startAyahGlobal": 4784,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّجْمِ إِذَا هَوَىٰ",
      "translations": {
        "en": {
          "text": "By the star when it descends,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تارے کی قسم جب غائب ہونے لگے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ",
      "translations": {
        "en": {
          "text": "Your companion [Muhammad] has not strayed, nor has he erred,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کہ تمہارے رفیق (محمدﷺ) نہ رستہ بھولے ہیں نہ بھٹکے ہیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ",
      "translations": {
        "en": {
          "text": "Nor does he speak from [his own] inclination.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور نہ خواہش نفس سے منہ سے بات نکالتے ہیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ",
      "translations": {
        "en": {
          "text": "It is not but a revelation revealed,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "یہ (قرآن) تو حکم خدا ہے جو (ان کی طرف) بھیجا جاتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ",
      "translations": {
        "en": {
          "text": "Taught to him by one intense in strength -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ان کو نہایت قوت والے نے سکھایا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 6,
      "arabic": "ذُو مِرَّةٍ فَٱسْتَوَىٰ",
      "translations": {
        "en": {
          "text": "One of soundness. And he rose to [his] true form",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یعنی جبرائیل) طاقتور نے پھر وہ پورے نظر آئے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 7,
      "arabic": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ",
      "translations": {
        "en": {
          "text": "While he was in the higher [part of the] horizon.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور وہ (آسمان کے) اونچے کنارے میں تھے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 8,
      "arabic": "ثُمَّ دَنَا فَتَدَلَّىٰ",
      "translations": {
        "en": {
          "text": "Then he approached and descended",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر قریب ہوئے اوراَور آگے بڑھے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 9,
      "arabic": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ",
      "translations": {
        "en": {
          "text": "And was at a distance of two bow lengths or nearer.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو دو کمان کے فاصلے پر یا اس سے بھی کم",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 10,
      "arabic": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ",
      "translations": {
        "en": {
          "text": "And he revealed to His Servant what he revealed.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر خدا نے اپنے بندے کی طرف جو بھیجا سو بھیجا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 11,
      "arabic": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ",
      "translations": {
        "en": {
          "text": "The heart did not lie [about] what it saw.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جو کچھ انہوں نے دیکھا ان کے دل نے اس کو جھوٹ نہ مانا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 12,
      "arabic": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",
      "translations": {
        "en": {
          "text": "So will you dispute with him over what he saw?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کیا جو کچھ وہ دیکھتے ہیں تم اس میں ان سے جھگڑتے ہو؟",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 13,
      "arabic": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ",
      "translations": {
        "en": {
          "text": "And he certainly saw him in another descent",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور انہوں نے اس کو ایک بار بھی دیکھا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 14,
      "arabic": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ",
      "translations": {
        "en": {
          "text": "At the Lote Tree of the Utmost Boundary -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پرلی حد کی بیری کے پاس",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 15,
      "arabic": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ",
      "translations": {
        "en": {
          "text": "Near it is the Garden of Refuge -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اسی کے پاس رہنے کی جنت ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 16,
      "arabic": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ",
      "translations": {
        "en": {
          "text": "When there covered the Lote Tree that which covered [it].",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جب کہ اس بیری پر چھا رہا تھا جو چھا رہا تھا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 17,
      "arabic": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ",
      "translations": {
        "en": {
          "text": "The sight [of the Prophet] did not swerve, nor did it transgress [its limit].",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ان کی آنکھ نہ تو اور طرف مائل ہوئی اور نہ (حد سے) آگے بڑھی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 18,
      "arabic": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ",
      "translations": {
        "en": {
          "text": "He certainly saw of the greatest signs of his Lord.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "انہوں نے اپنے پروردگار (کی قدرت) کی کتنی ہی بڑی بڑی نشانیاں دیکھیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 19,
      "arabic": "أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ",
      "translations": {
        "en": {
          "text": "So have you considered al-Lat and al-'Uzza?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بھلا تم لوگوں نے لات اور عزیٰ کو دیکھا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 20,
      "arabic": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ",
      "translations": {
        "en": {
          "text": "And Manat, the third - the other one?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور تیسرے منات کو (کہ یہ بت کہیں خدا ہوسکتے ہیں)",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 21,
      "arabic": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ",
      "translations": {
        "en": {
          "text": "Is the male for you and for Him the female?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(مشرکو!) کیا تمہارے لئے تو بیٹے اور خدا کے لئے بیٹیاں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 22,
      "arabic": "تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ",
      "translations": {
        "en": {
          "text": "That, then, is an unjust division.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "یہ تقسیم تو بہت بےانصافی کی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 23,
      "arabic": "إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",
      "translations": {
        "en": {
          "text": "They are not but [mere] names you have named them - you and your forefathers - for which Allah has sent down no authority. They follow not except assumption and what [their] souls desire, and there has already come to them from their Lord guidance.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "وہ تو صرف نام ہی نام ہیں جو تم نے اور تمہارے باپ دادا نے گھڑ لئے ہیں۔ خدا نے تو ان کی کوئی سند نازل نہیں کی۔ یہ لوگ محض ظن (فاسد) اور خواہشات نفس کے پیچھے چل رہے ہیں۔ حالانکہ ان کے پروردگار کی طرف سے ان کے پاس ہدایت آچکی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 24,
      "arabic": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ",
      "translations": {
        "en": {
          "text": "Or is there for man whatever he wishes?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کیا جس چیز کی انسان آرزو کرتا ہے وہ اسے ضرور ملتی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 25,
      "arabic": "فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ",
      "translations": {
        "en": {
          "text": "Rather, to Allah belongs the Hereafter and the first [life].",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "آخرت اور دنیا تو الله ہی کے ہاتھ میں ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 26,
      "arabic": "وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ",
      "translations": {
        "en": {
          "text": "And how many angels there are in the heavens whose intercession will not avail at all except [only] after Allah has permitted [it] to whom He wills and approves.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور آسمانوں میں بہت سے فرشتے ہیں جن کی سفارش کچھ بھی فائدہ نہیں دیتی مگر اس وقت کہ خدا جس کے لئے چاہے اجازت بخشے اور (سفارش) پسند کرے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 27,
      "arabic": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",
      "translations": {
        "en": {
          "text": "Indeed, those who do not believe in the Hereafter name the angels female names,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جو لوگ آخرت پر ایمان نہیں لاتے وہ فرشتوں کو (خدا کی) لڑکیوں کے نام سے موسوم کرتے ہیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 28,
      "arabic": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا",
      "translations": {
        "en": {
          "text": "And they have thereof no knowledge. They follow not except assumption, and indeed, assumption avails not against the truth at all.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "حالانکہ ان کو اس کی کچھ خبر نہیں۔ وہ صرف ظن پر چلتے ہیں۔ اور ظن یقین کے مقابلے میں کچھ کام نہیں آتا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 29,
      "arabic": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "translations": {
        "en": {
          "text": "So turn away from whoever turns his back on Our message and desires not except the worldly life.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو جو ہماری یاد سے روگردانی اور صرف دنیا ہی کی زندگی کا خواہاں ہو اس سے تم بھی منہ پھیر لو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 30,
      "arabic": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ",
      "translations": {
        "en": {
          "text": "That is their sum of knowledge. Indeed, your Lord is most knowing of who strays from His way, and He is most knowing of who is guided.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ان کے علم کی انتہا یہی ہے۔ تمہارا پروردگار اس کو بھی خوب جانتا ہے جو اس کے رستے سے بھٹک گیا اور اس سے بھی خوب واقف ہے جو رستے پر چلا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 31,
      "arabic": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
      "translations": {
        "en": {
          "text": "And to Allah belongs whatever is in the heavens and whatever is in the earth - that He may recompense those who do evil with [the penalty of] what they have done and recompense those who do good with the best [reward] -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور جو کچھ آسمانوں میں ہے اور جو کچھ زمین میں ہے سب خدا ہی کا ہے (اور اس نے خلقت کو) اس لئے (پیدا کیا ہے) کہ جن لوگوں نے برے کام کئے ان کو ان کے اعمال کا (برا) بدلا دے اور جنہوں نے نیکیاں کیں ان کو نیک بدلہ دے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 32,
      "arabic": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَٰتِكُمْ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
      "translations": {
        "en": {
          "text": "Those who avoid the major sins and immoralities, only [committing] slight ones. Indeed, your Lord is vast in forgiveness. He was most knowing of you when He produced you from the earth and when you were fetuses in the wombs of your mothers. So do not claim yourselves to be pure; He is most knowing of who fears Him.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جو صغیرہ گناہوں کے سوا بڑے بڑے گناہوں اور بےحیائی کی باتوں سے اجتناب کرتے ہیں۔ بےشک تمہارا پروردگار بڑی بخشش والا ہے۔ وہ تم کو خوب جانتا ہے۔ جب اس نے تم کو مٹی سے پیدا کیا اور جب تم اپنی ماؤں کے پیٹ میں بچّے تھے۔ تو اپنے آپ کو پاک صاف نہ جتاؤ۔ جو پرہیزگار ہے وہ اس سے خوب واقف ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 33,
      "arabic": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ",
      "translations": {
        "en": {
          "text": "Have you seen the one who turned away",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بھلا تم نے اس شخص کو دیکھا جس نے منہ پھیر لیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 34,
      "arabic": "وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ",
      "translations": {
        "en": {
          "text": "And gave a little and [then] refrained?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور تھوڑا سا دیا (پھر) ہاتھ روک لیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 35,
      "arabic": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ",
      "translations": {
        "en": {
          "text": "Does he have knowledge of the unseen, so he sees?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کیا اس کے پاس غیب کا علم ہے کہ وہ اس کو دیکھ رہا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 36,
      "arabic": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ",
      "translations": {
        "en": {
          "text": "Or has he not been informed of what was in the scriptures of Moses",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کیا جو باتیں موسیٰ کے صحیفوں میں ہیں ان کی اس کو خبر نہیں پہنچی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 37,
      "arabic": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ",
      "translations": {
        "en": {
          "text": "And [of] Abraham, who fulfilled [his obligations] -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور ابراہیمؑ کی جنہوں نے (حق طاعت ورسالت) پورا کیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 38,
      "arabic": "أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ",
      "translations": {
        "en": {
          "text": "That no bearer of burdens will bear the burden of another",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "یہ کہ کوئی شخص دوسرے (کے گناہ) کا بوجھ نہیں اٹھائے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 39,
      "arabic": "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰ",
      "translations": {
        "en": {
          "text": "And that there is not for man except that [good] for which he strives",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ انسان کو وہی ملتا ہے جس کی وہ کوشش کرتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 40,
      "arabic": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ",
      "translations": {
        "en": {
          "text": "And that his effort is going to be seen -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ اس کی کوشش دیکھی جائے گی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 41,
      "arabic": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",
      "translations": {
        "en": {
          "text": "Then he will be recompensed for it with the fullest recompense",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر اس کو اس کا پورا پورا بدلا دیا جائے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 42,
      "arabic": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",
      "translations": {
        "en": {
          "text": "And that to your Lord is the finality",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ تمہارے پروردگار ہی کے پاس پہنچنا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 43,
      "arabic": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ",
      "translations": {
        "en": {
          "text": "And that it is He who makes [one] laugh and weep",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ وہ ہنساتا اور رلاتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 44,
      "arabic": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا",
      "translations": {
        "en": {
          "text": "And that it is He who causes death and gives life",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ وہی مارتا اور جلاتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 45,
      "arabic": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ",
      "translations": {
        "en": {
          "text": "And that He creates the two mates - the male and female -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ وہی نر اور مادہ دو قسم (کے حیوان) پیدا کرتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 46,
      "arabic": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ",
      "translations": {
        "en": {
          "text": "From a sperm-drop when it is emitted",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یعنی) نطفے سے جو (رحم میں) ڈالا جاتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 47,
      "arabic": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ",
      "translations": {
        "en": {
          "text": "And that [incumbent] upon Him is the next creation",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ (قیامت کو) اسی پر دوبارہ اٹھانا لازم ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 48,
      "arabic": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ",
      "translations": {
        "en": {
          "text": "And that it is He who enriches and suffices",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ وہی دولت مند بناتا اور مفلس کرتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 49,
      "arabic": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ",
      "translations": {
        "en": {
          "text": "And that it is He who is the Lord of Sirius",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ وہی شعریٰ کا مالک ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 50,
      "arabic": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
      "translations": {
        "en": {
          "text": "And that He destroyed the first [people of] 'Aad",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور یہ کہ اسی نے عاد اول کو ہلاک کر ڈالا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 51,
      "arabic": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
      "translations": {
        "en": {
          "text": "And Thamud - and He did not spare [them] -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور ثمود کو بھی۔ غرض کسی کو باقی نہ چھوڑا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 52,
      "arabic": "وَقَوْمَ نُوحٍ مِّن قَبْلُ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
      "translations": {
        "en": {
          "text": "And the people of Noah before. Indeed, it was they who were [even] more unjust and oppressing.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور ان سے پہلے قوم نوحؑ کو بھی۔ کچھ شک نہیں کہ وہ لوگ بڑے ہی ظالم اور بڑے ہی سرکش تھے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 53,
      "arabic": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ",
      "translations": {
        "en": {
          "text": "And the overturned towns He hurled down",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور اسی نے الٹی ہوئی بستیوں کو دے پٹکا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 54,
      "arabic": "فَغَشَّىٰهَا مَا غَشَّىٰ",
      "translations": {
        "en": {
          "text": "And covered them by that which He covered.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر ان پر چھایا جو چھایا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 55,
      "arabic": "فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ",
      "translations": {
        "en": {
          "text": "Then which of the favors of your Lord do you doubt?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو (اے انسان) تو اپنے پروردگار کی کون سی نعمت پر جھگڑے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 56,
      "arabic": "هَٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ",
      "translations": {
        "en": {
          "text": "This [Prophet] is a warner like the former warners.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "یہ (محمدﷺ) بھی اگلے ڈر سنانے والوں میں سے ایک ڈر سنانے والے ہیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 57,
      "arabic": "أَزِفَتِ ٱلْـَٔازِفَةُ",
      "translations": {
        "en": {
          "text": "The Approaching Day has approached.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "آنے والی (یعنی قیامت) قریب آ پہنچی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 58,
      "arabic": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",
      "translations": {
        "en": {
          "text": "Of it, [from those] besides Allah, there is no remover.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اس (دن کی تکلیفوں) کو خدا کے سوا کوئی دور نہیں کرسکے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 59,
      "arabic": "أَفَمِنْ هَٰذَا ٱلْحَدِيثِ تَعْجَبُونَ",
      "translations": {
        "en": {
          "text": "Then at this statement do you wonder?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اے منکرین خدا) کیا تم اس کلام سے تعجب کرتے ہو؟",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 60,
      "arabic": "وَتَضْحَكُونَ وَلَا تَبْكُونَ",
      "translations": {
        "en": {
          "text": "And you laugh and do not weep",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور ہنستے ہو اور روتے نہیں؟",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 61,
      "arabic": "وَأَنتُمْ سَٰمِدُونَ",
      "translations": {
        "en": {
          "text": "While you are proudly sporting?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور تم غفلت میں پڑ رہے ہو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 62,
      "arabic": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟",
      "translations": {
        "en": {
          "text": "So prostrate to Allah and worship [Him].",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو خدا کے آگے سجدہ کرو اور (اسی کی) عبادت کرو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
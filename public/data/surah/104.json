{
  "id": 104,
  "nameArabic": "الهمزة",
  "nameTransliteration": "Al-Humaza",
  "nameEnglish": "The Traducer",
  "ayahCount": 9,
  "revelationType": "Meccan",
  "revelationOrder": 32,
  "rukus": 1,
  "startAyahGlobal": 6179,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "translations": {
        "en": {
          "text": "Woe to every scorner and mocker",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
      "translations": {
        "en": {
          "text": "Who collects wealth and [continuously] counts it.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "translations": {
        "en": {
          "text": "He thinks that his wealth will make him immortal.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "translations": {
        "en": {
          "text": "No! He will surely be thrown into the Crusher.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "translations": {
        "en": {
          "text": "And what can make you know what is the Crusher?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور تم کیا سمجھے حطمہ کیا ہے؟",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 6,
      "arabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "translations": {
        "en": {
          "text": "It is the fire of Allah, [eternally] fueled,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "وہ خدا کی بھڑکائی ہوئی آگ ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 7,
      "arabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "translations": {
        "en": {
          "text": "Which mounts directed at the hearts.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جو دلوں پر جا لپٹے گی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 8,
      "arabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "translations": {
        "en": {
          "text": "Indeed, Hellfire will be closed down upon them",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(اور) وہ اس میں بند کر دیئے جائیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 9,
      "arabic": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
      "translations": {
        "en": {
          "text": "In extended columns.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یعنی آگ کے) لمبے لمبے ستونوں میں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
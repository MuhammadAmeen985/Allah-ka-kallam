{
  "id": 114,
  "nameArabic": "الناس",
  "nameTransliteration": "An-Naas",
  "nameEnglish": "Mankind",
  "ayahCount": 6,
  "revelationType": "Meccan",
  "revelationOrder": 21,
  "rukus": 1,
  "startAyahGlobal": 6230,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "translations": {
        "en": {
          "text": "Say, \"I seek refuge in the Lord of mankind,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کہو کہ میں لوگوں کے پروردگار کی پناہ مانگتا ہوں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "مَلِكِ ٱلنَّاسِ",
      "translations": {
        "en": {
          "text": "The Sovereign of mankind.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یعنی) لوگوں کے حقیقی بادشاہ کی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "إِلَٰهِ ٱلنَّاسِ",
      "translations": {
        "en": {
          "text": "The God of mankind,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "لوگوں کے معبود برحق کی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
      "translations": {
        "en": {
          "text": "From the evil of the retreating whisperer -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(شیطان) وسوسہ انداز کی برائی سے جو (خدا کا نام سن کر) پیچھے ہٹ جاتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
      "translations": {
        "en": {
          "text": "Who whispers [evil] into the breasts of mankind -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جو لوگوں کے دلوں میں وسوسے ڈالتا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 6,
      "arabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
      "translations": {
        "en": {
          "text": "From among the jinn and mankind.\"",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "وہ جنّات میں سے (ہو) یا انسانوں میں سے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
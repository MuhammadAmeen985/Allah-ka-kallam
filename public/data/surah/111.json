{
  "id": 111,
  "nameArabic": "المسد",
  "nameTransliteration": "Al-Masad",
  "nameEnglish": "The Palm Fibre",
  "ayahCount": 5,
  "revelationType": "Meccan",
  "revelationOrder": 6,
  "rukus": 1,
  "startAyahGlobal": 6216,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ",
      "translations": {
        "en": {
          "text": "May the hands of Abu Lahab be ruined, and ruined is he.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ابولہب کے ہاتھ ٹوٹیں اور وہ ہلاک ہو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ",
      "translations": {
        "en": {
          "text": "His wealth will not avail him or that which he gained.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "نہ تو اس کا مال ہی اس کے کچھ کام آیا اور نہ وہ جو اس نے کمایا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ",
      "translations": {
        "en": {
          "text": "He will [enter to] burn in a Fire of [blazing] flame",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "وہ جلد بھڑکتی ہوئی آگ میں داخل ہو گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ",
      "translations": {
        "en": {
          "text": "And his wife [as well] - the carrier of firewood.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور اس کی جورو بھی جو ایندھن سر پر اٹھائے پھرتی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ",
      "translations": {
        "en": {
          "text": "Around her neck is a rope of [twisted] fiber.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اس کے گلے میں مونج کی رسّی ہو گی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
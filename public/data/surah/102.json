{
  "id": 102,
  "nameArabic": "التكاثر",
  "nameTransliteration": "At-Takaathur",
  "nameEnglish": "Competition",
  "ayahCount": 8,
  "revelationType": "Meccan",
  "revelationOrder": 16,
  "rukus": 1,
  "startAyahGlobal": 6168,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
      "translations": {
        "en": {
          "text": "Competition in [worldly] increase diverts you",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(لوگو) تم کو (مال کی) بہت سی طلب نے غافل کر دیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ",
      "translations": {
        "en": {
          "text": "Until you visit the graveyards.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "یہاں تک کہ تم نے قبریں جا دیکھیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "translations": {
        "en": {
          "text": "No! You are going to know.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "دیکھو تمہیں عنقریب معلوم ہو جائے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
      "translations": {
        "en": {
          "text": "Then no! You are going to know.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر دیکھو تمہیں عنقریب معلوم ہو جائے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
      "translations": {
        "en": {
          "text": "No! If you only knew with knowledge of certainty...",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "دیکھو اگر تم جانتے (یعنی) علم الیقین (رکھتے تو غفلت نہ کرتے)",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 6,
      "arabic": "لَتَرَوُنَّ ٱلْجَحِيمَ",
      "translations": {
        "en": {
          "text": "You will surely see the Hellfire.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تم ضرور دوزخ کو دیکھو گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 7,
      "arabic": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
      "translations": {
        "en": {
          "text": "Then you will surely see it with the eye of certainty.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر اس کو (ایسا) دیکھو گے (کہ) عین الیقین (آ جائے گا)",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 8,
      "arabic": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "translations": {
        "en": {
          "text": "Then you will surely be asked that Day about pleasure.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر اس روز تم سے (شکر) نعمت کے بارے میں پرسش ہو گی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
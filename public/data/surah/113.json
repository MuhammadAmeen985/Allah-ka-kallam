{
  "id": 113,
  "nameArabic": "الفلق",
  "nameTransliteration": "Al-Falaq",
  "nameEnglish": "The Dawn",
  "ayahCount": 5,
  "revelationType": "Meccan",
  "revelationOrder": 20,
  "rukus": 1,
  "startAyahGlobal": 6225,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
      "translations": {
        "en": {
          "text": "Say, \"I seek refuge in the Lord of daybreak",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کہو کہ میں صبح کے پروردگار کی پناہ مانگتا ہوں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "مِن شَرِّ مَا خَلَقَ",
      "translations": {
        "en": {
          "text": "From the evil of that which He created",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "ہر چیز کی بدی سے جو اس نے پیدا کی",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "translations": {
        "en": {
          "text": "And from the evil of darkness when it settles",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور شب تاریکی کی برائی سے جب اس کااندھیرا چھا جائے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ",
      "translations": {
        "en": {
          "text": "And from the evil of the blowers in knots",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور گنڈوں پر (پڑھ پڑھ کر) پھونکنے والیوں کی برائی سے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "translations": {
        "en": {
          "text": "And from the evil of an envier when he envies.\"",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور حسد کرنے والے کی برائی سے جب حسد کرنے لگے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
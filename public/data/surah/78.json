{
  "id": 78,
  "nameArabic": "النبإ",
  "nameTransliteration": "An-Naba",
  "nameEnglish": "The Announcement",
  "ayahCount": 40,
  "revelationType": "Meccan",
  "revelationOrder": 80,
  "rukus": 2,
  "startAyahGlobal": 5672,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ",
      "translations": {
        "en": {
          "text": "About what are they asking one another?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یہ) لوگ کس چیز کی نسبت پوچھتے ہیں؟",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "translations": {
        "en": {
          "text": "About the great news -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(کیا) بڑی خبر کی نسبت؟",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "translations": {
        "en": {
          "text": "That over which they are in disagreement.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جس میں یہ اختلاف کر رہے ہیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 4,
      "arabic": "كَلَّا سَيَعْلَمُونَ",
      "translations": {
        "en": {
          "text": "No! They are going to know.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "دیکھو یہ عنقریب جان لیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 5,
      "arabic": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "translations": {
        "en": {
          "text": "Then, no! They are going to know.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "پھر دیکھو یہ عنقریب جان لیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 6,
      "arabic": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا",
      "translations": {
        "en": {
          "text": "Have We not made the earth a resting place?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کیا ہم نے زمین کو بچھونا نہیں بنایا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 7,
      "arabic": "وَٱلْجِبَالَ أَوْتَادًا",
      "translations": {
        "en": {
          "text": "And the mountains as stakes?",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور پہاڑوں کو (ا س کی) میخیں (نہیں ٹھہرایا؟)",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 8,
      "arabic": "وَخَلَقْنَٰكُمْ أَزْوَٰجًا",
      "translations": {
        "en": {
          "text": "And We created you in pairs",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(بے شک بنایا) اور تم کو جوڑا جوڑابھی پیدا کیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 9,
      "arabic": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
      "translations": {
        "en": {
          "text": "And made your sleep [a means for] rest",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور نیند کو تمہارے لیے (موجب) آرام بنایا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 10,
      "arabic": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
      "translations": {
        "en": {
          "text": "And made the night as clothing",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور رات کو پردہ مقرر کیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 11,
      "arabic": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
      "translations": {
        "en": {
          "text": "And made the day for livelihood",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور دن کو معاش (کا وقت) قرار دیا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 12,
      "arabic": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "translations": {
        "en": {
          "text": "And constructed above you seven strong [heavens]",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور تمہارے اوپر سات مضبوط (آسمان) بنائے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 13,
      "arabic": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
      "translations": {
        "en": {
          "text": "And made [therein] a burning lamp",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور (آفتاب کا) روشن چراغ بنایا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 14,
      "arabic": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
      "translations": {
        "en": {
          "text": "And sent down, from the rain clouds, pouring water",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور نچڑتے بادلوں سے موسلا دھار مینہ برسایا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 15,
      "arabic": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
      "translations": {
        "en": {
          "text": "That We may bring forth thereby grain and vegetation",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تاکہ اس سے اناج اور سبزہ پیدا کریں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 16,
      "arabic": "وَجَنَّٰتٍ أَلْفَافًا",
      "translations": {
        "en": {
          "text": "And gardens of entwined growth.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور گھنے گھنے باغ",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 17,
      "arabic": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا",
      "translations": {
        "en": {
          "text": "Indeed, the Day of Judgement is an appointed time -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بےشک فیصلہ کا دن مقرر ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 18,
      "arabic": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
      "translations": {
        "en": {
          "text": "The Day the Horn is blown and you will come forth in multitudes",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "جس دن صور پھونکا جائے گا تو تم لوگ غٹ کے غٹ آ موجود ہو گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 19,
      "arabic": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
      "translations": {
        "en": {
          "text": "And the heaven is opened and will become gateways",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور آسمان کھولا جائے گا تو (اس میں) دروازے ہو جائیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 20,
      "arabic": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "translations": {
        "en": {
          "text": "And the mountains are removed and will be [but] a mirage.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور پہاڑ چلائے جائیں گے تو وہ ریت ہو کر رہ جائیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 21,
      "arabic": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
      "translations": {
        "en": {
          "text": "Indeed, Hell has been lying in wait",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بےشک دوزخ گھات میں ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 22,
      "arabic": "لِّلطَّٰغِينَ مَـَٔابًا",
      "translations": {
        "en": {
          "text": "For the transgressors, a place of return,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یعنی) سرکشوں کا وہی ٹھکانہ ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 23,
      "arabic": "لَّٰبِثِينَ فِيهَآ أَحْقَابًا",
      "translations": {
        "en": {
          "text": "In which they will remain for ages [unending].",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اس میں وہ مدتوں پڑے رہیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 24,
      "arabic": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
      "translations": {
        "en": {
          "text": "They will not taste therein [any] coolness or drink",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "وہاں نہ ٹھنڈک کا مزہ چکھیں گے۔ نہ (کچھ) پینا (نصیب ہو گا)",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 25,
      "arabic": "إِلَّا حَمِيمًا وَغَسَّاقًا",
      "translations": {
        "en": {
          "text": "Except scalding water and [foul] purulence -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "مگر گرم پانی اور بہتی پیپ",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 26,
      "arabic": "جَزَآءً وِفَاقًا",
      "translations": {
        "en": {
          "text": "An appropriate recompense.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یہ) بدلہ ہے پورا پورا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 27,
      "arabic": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
      "translations": {
        "en": {
          "text": "Indeed, they were not expecting an account",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "یہ لوگ حساب (آخرت) کی امید ہی نہیں رکھتے تھے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 28,
      "arabic": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًا",
      "translations": {
        "en": {
          "text": "And denied Our verses with [emphatic] denial.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور ہماری آیتوں کو جھوٹ سمجھ کر جھٹلاتے رہتے تھے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 29,
      "arabic": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا",
      "translations": {
        "en": {
          "text": "But all things We have enumerated in writing.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور ہم نے ہر چیز کو لکھ کر ضبط کر رکھا ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 30,
      "arabic": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "translations": {
        "en": {
          "text": "\"So taste [the penalty], and never will We increase you except in torment.\"",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "سو (اب) مزہ چکھو۔ ہم تم پر عذاب ہی بڑھاتے جائیں گے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 31,
      "arabic": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "translations": {
        "en": {
          "text": "Indeed, for the righteous is attainment -",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "بے شک پرہیز گاروں کے لیے کامیابی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 32,
      "arabic": "حَدَآئِقَ وَأَعْنَٰبًا",
      "translations": {
        "en": {
          "text": "Gardens and grapevines",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(یعنی) باغ اور انگور",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 33,
      "arabic": "وَكَوَاعِبَ أَتْرَابًا",
      "translations": {
        "en": {
          "text": "And full-breasted [companions] of equal age",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور ہم عمر نوجوان عورتیں",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 34,
      "arabic": "وَكَأْسًا دِهَاقًا",
      "translations": {
        "en": {
          "text": "And a full cup.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "اور شراب کے چھلکتے ہوئے گلاس",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },

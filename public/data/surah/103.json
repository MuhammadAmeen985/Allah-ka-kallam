{
  "id": 103,
  "nameArabic": "العصر",
  "nameTransliteration": "Al-Asr",
  "nameEnglish": "The Declining Day, Epoch",
  "ayahCount": 3,
  "revelationType": "Meccan",
  "revelationOrder": 13,
  "rukus": 1,
  "startAyahGlobal": 6176,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ",
      "translations": {
        "en": {
          "text": "By time,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "عصر کی قسم",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ",
      "translations": {
        "en": {
          "text": "Indeed, mankind is in loss,",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کہ انسان نقصان میں ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ",
      "translations": {
        "en": {
          "text": "Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "مگر وہ لوگ جو ایمان لائے اور نیک عمل کرتے رہے اور آپس میں حق (بات) کی تلقین اور صبر کی تاکید کرتے رہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}
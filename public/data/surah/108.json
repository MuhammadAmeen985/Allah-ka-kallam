{
  "id": 108,
  "nameArabic": "الكوثر",
  "nameTransliteration": "Al-Kawthar",
  "nameEnglish": "Abundance",
  "ayahCount": 3,
  "revelationType": "Meccan",
  "revelationOrder": 15,
  "rukus": 1,
  "startAyahGlobal": 6204,
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ",
      "translations": {
        "en": {
          "text": "Indeed, We have granted you, [O Muhammad], al-Kawthar.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "(اے محمدﷺ) ہم نے تم کو کوثر عطا فرمائی ہے",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 2,
      "arabic": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ",
      "translations": {
        "en": {
          "text": "So pray to your Lord and sacrifice [to Him alone].",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "تو اپنے پروردگار کے لیے نماز پڑھا کرو اور قربانی دیا کرو",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    },
    {
      "ayah": 3,
      "arabic": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ",
      "translations": {
        "en": {
          "text": "Indeed, your enemy is the one cut off.",
          "translator": "Saheeh International",
          "source": "Tanzil Project (tanzil.net)"
        },
        "ur": {
          "text": "کچھ شک نہیں کہ تمہارا دشمن ہی بےاولاد رہے گا",
          "translator": "Fateh Muhammad Jalandhry (فتح محمد جالندھری)",
          "source": "Tanzil Project (tanzil.net)"
        }
      }
    }
  ]
}